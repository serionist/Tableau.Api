<Project Sdk="Microsoft.NET.Sdk">

  <!-- The target, the strictness and the version are in the Directory.Build.props files, the package versions in
       Directory.Packages.props. -->
  <PropertyGroup>
    <Description>A .NET client for the Tableau REST API, on Tableau Server and Tableau Cloud, and for Vizportal, the undocumented API behind Tableau's web client. Not affiliated with or endorsed by Tableau or Salesforce.</Description>
    <PackageTags>Tableau, Tableau API, Tableau C#</PackageTags>
  </PropertyGroup>

  <!-- The trim and native AOT analyzers run on the library's build, and fail it on a warning. The old client's files,
       XmlSerializer's and Newtonsoft.Json's, are exempt through the TableauLegacy section of .editorconfig until they
       are ported. VerifyReferenceAotCompatibility waits for the old client to go, with Newtonsoft.Json. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The abstractions a caller's host provides the rest of: logging, options with their validation, DI, and the
       HttpClient factory that AddTableauClient registers its named client with. Polly.Core runs the retries, from a
       handler of the library's own: no package of it registers services, logs or changes how an app builds.
       Newtonsoft.Json is the old Vizportal client's, and goes with it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <!-- The envelopes of a request and a response, the JSON context, the converters and the client's pipeline are
       internal: the tests and the native AOT app read fixtures and drive the pipeline through them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tableau.Api.Tests" />
    <InternalsVisibleTo Include="Tableau.Api.Aot" />
  </ItemGroup>

</Project>
