<Project>

  <!-- What every project shares lives here, once, never per .csproj. The modernization adds the target framework and
       the strictness settings (Nullable, TreatWarningsAsErrors, EnforceCodeStyleInBuild) here when the code is ready
       for them. -->

  <PropertyGroup Label="Package metadata">
    <Authors>Soma Osvay, László Nemes</Authors>
    <PackageProjectUrl>https://github.com/serionist/Tableau.Api</PackageProjectUrl>
    <RepositoryUrl>https://github.com/serionist/Tableau.Api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Label="Package advisories">
    <!-- Every package with a known advisory, direct or transitive, shows in the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

</Project>
