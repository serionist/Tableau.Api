{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git diff --cached*)",
      "Bash(git diff HEAD)",
      "Bash(git diff HEAD *)",
      "Bash(git diff origin/main...HEAD*)",
      "Bash(git diff --stat origin/main...HEAD*)",
      "Bash(git diff --name-only origin/main...HEAD*)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(git fetch origin)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list*)",
      "Bash(dotnet build Tableau.Api/Tableau.Api.csproj)",
      "Bash(dotnet restore Tableau.Api/Tableau.Api.csproj)",
      "Bash(dotnet format Tableau.Api/Tableau.Api.csproj --verify-no-changes)",
      "Bash(dotnet run eng/gate.cs -- quick*)",
      "Bash(dotnet run eng/gate.cs -- full*)",
      "Bash(dotnet run eng/gate.cs -- text *)",
      "Bash(dotnet run eng/gate.cs -- selftest)"
    ],
    "deny": [
      "Read(**/*.runsettings)",
      "Read(**/testsettings.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.secrets)",
      "Read(**/*.token)",
      "Read(**/.claude/settings.local.json)",
      "Bash(git diff --no-index*)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff --output*)",
      "Bash(git diff *--output*)",
      "Bash(git log --output*)",
      "Bash(git log *--output*)",
      "Bash(git show --output*)",
      "Bash(git show *--output*)",
      "Bash(git blame --contents*)",
      "Bash(git blame *--contents*)",
      "Bash(git blame *-S*)",
      "Bash(git blame *--ignore-revs-file*)",
      "Bash(dotnet *@*)",
      "Bash(git commit *--no-v*)",
      "Bash(git push *--no-v*)"
    ],
    "ask": [
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)"
    ]
  }
}
