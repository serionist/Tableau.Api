{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git diff --cached --name-only)",
      "Bash(git diff HEAD)",
      "Bash(git diff origin/main...HEAD)",
      "Bash(git diff --stat origin/main...HEAD)",
      "Bash(git diff --name-only origin/main...HEAD)",
      "Bash(git log)",
      "Bash(git log --oneline)",
      "Bash(git log origin/main..HEAD)",
      "Bash(git log --oneline origin/main..HEAD)",
      "Bash(git show)",
      "Bash(git show --stat)",
      "Bash(git ls-files)",
      "Bash(git rev-parse HEAD)",
      "Bash(git rev-parse --short HEAD)",
      "Bash(git rev-parse FETCH_HEAD)",
      "Bash(git rev-parse --show-toplevel)",
      "Bash(git merge-base origin/main HEAD)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(git worktree list --porcelain)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin main:refs/remotes/origin/main)",
      "Bash(gh issue list)",
      "Bash(gh pr list)",
      "Bash(gh pr view)",
      "Bash(gh pr view --comments)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff --name-only)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks --watch)",
      "Bash(dotnet build Tableau.Api/Tableau.Api.csproj)",
      "Bash(dotnet restore Tableau.Api/Tableau.Api.csproj)",
      "Bash(dotnet format Tableau.Api/Tableau.Api.csproj --verify-no-changes)",
      "Bash(dotnet run eng/gate.cs -- quick)",
      "Bash(dotnet run eng/gate.cs -- full)",
      "Bash(dotnet run eng/gate.cs -- text --file -)",
      "Bash(dotnet run eng/gate.cs -- text --file .local/pr-text.md)",
      "Bash(dotnet run eng/gate.cs -- selftest)"
    ],
    "deny": [
      "Read(**/*.runsettings)",
      "Read(**/testsettings.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.secrets)",
      "Read(**/*.token)",
      "Read(**/.claude/settings.local.json)",
      "Bash(git commit *--no-v*)",
      "Bash(git push *--no-v*)",
      "Bash(dotnet *@*)",
      "PowerShell(git commit *--no-v*)",
      "PowerShell(git push *--no-v*)",
      "PowerShell(dotnet *@*)"
    ],
    "ask": [
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(dotnet test*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(dotnet test*)"
    ]
  }
}
