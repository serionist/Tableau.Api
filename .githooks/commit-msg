#!/bin/sh
# Refuses tool attribution in the message (AGENTS.md, Commits and PRs). Turned on by `dotnet run eng/gate.cs -- setup`.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v dotnet >/dev/null 2>&1; then
    echo "commit-msg: dotnet not found, hook skipped; gate quick still checks the branch's messages" >&2
    exit 0
fi
[ -f eng/gate.cs ] || exit 0
exec dotnet run eng/gate.cs -- commit-msg "$@"
