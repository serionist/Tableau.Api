#!/bin/sh
# After a merge or a pull, names the AI setup files that changed, so an agent re-reads them. Turned on by
# `dotnet run eng/gate.cs -- setup`. Only informs: always exits 0.
cd "$(git rev-parse --show-toplevel)" || exit 0
if ! command -v dotnet >/dev/null 2>&1; then
    echo "post-merge: dotnet not found, hook skipped" >&2
    exit 0
fi
[ -f eng/gate.cs ] && dotnet run eng/gate.cs -- post-merge "$@"
exit 0
