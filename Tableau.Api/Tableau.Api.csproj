<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>Soma Osvay</Authors>
    <Company>Starschema Ltd</Company>
    <Description>A C# wrapper around Tableau API. All versions and endpoints are supported up to 2018.2</Description>
    <PackageProjectUrl>https://starschema.visualstudio.com/Tableau.Api</PackageProjectUrl>
    <RepositoryUrl>https://starschema.visualstudio.com/_git/Tableau.Api</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>Tableau, Tableau API, Tableau C#</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.1.1" />
  </ItemGroup>

</Project>
