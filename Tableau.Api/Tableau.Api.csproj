<Project Sdk="Microsoft.NET.Sdk">

  <!-- The licence expression and the repository URLs are in Directory.Build.props, once for every project. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- netstandard2.0 defaults to C# 7.3. A fixed version, not latest, so a newer SDK never changes what compiles. -->
    <LangVersion>10</LangVersion>
    <!-- A new warning fails the build; the doc-comment ones 1.2.5 already had stay warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1570;CS1572;CS1573;CS1591</WarningsNotAsErrors>
    <Description>A .NET client for the Tableau REST API, on Tableau Server and Tableau Cloud. Not affiliated with or endorsed by Tableau or Salesforce.</Description>
    <PackageTags>Tableau, Tableau API, Tableau C#</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbols go to nuget.org's symbol server as a .snupkg; Source Link points them at the code on GitHub, so the
         package carries no copy of the source. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- The assembly and file versions follow the package's, as 1.2.5's 1.0.2.5 did. -->
    <AssemblyVersion>1.0.2.6</AssemblyVersion>
    <FileVersion>1.0.2.6</FileVersion>
    <Version>1.2.6</Version>
  </PropertyGroup>

  <!-- Every pack compares the package with 1.2.5 on nuget.org and fails when a member 1.2.5 has is removed or changed.
       An added public member passes, so a review looks for one. No suppression file is allowed (CI fails when one
       exists), and CI also runs the ApiCompat tool on the package, which reads no property of this project, so
       nothing here can quiet it. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.5</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- On GitHub's runners the build writes no path of the runner into the assembly or its symbols, so the same commit
       builds the same files wherever it runs. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>bin\Debug\netstandard2.0\Tableau.Api.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>bin\Release\netstandard2.0\Tableau.Api.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
