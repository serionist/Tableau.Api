<Project Sdk="Microsoft.NET.Sdk">

  <!-- The licence expression and the repository URLs are in Directory.Build.props, once for every project. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Description>A .NET client for the Tableau REST API, on Tableau Server and Tableau Cloud, and for Vizportal, the undocumented API behind Tableau's web client. Not affiliated with or endorsed by Tableau or Salesforce.</Description>
    <PackageTags>Tableau, Tableau API, Tableau C#</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbols go to nuget.org's symbol server as a .snupkg; Source Link points them at the code on GitHub, so the
         package carries no copy of the source. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AssemblyVersion>1.0.2.5</AssemblyVersion>
    <FileVersion>1.0.2.5</FileVersion>
    <Version>1.2.5</Version>
  </PropertyGroup>

  <!-- On GitHub's runners the build writes no path of the runner into the assembly or its symbols, so the same commit
       builds the same files wherever it runs. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>bin\Debug\netstandard2.0\Tableau.Api.xml</DocumentationFile>
    <NoWarn>1701;1702;IDE1006;NU1701;CA2254;CA1016;CA1822;IDE0063;CA1845;IDE0057;CS1591;IL2026;IL2104;</NoWarn>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>bin\Release\netstandard2.0\Tableau.Api.xml</DocumentationFile>
    <NoWarn>1701;1702;IDE1006;NU1701;CA2254;CA1016;CA1822;IDE0063;CA1845;IDE0057;CS1591;IL2026;IL2104;</NoWarn>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
