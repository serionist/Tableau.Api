<?xml version="1.0" encoding="utf-8"?>
<!-- What the coverage run measures: the library alone, without the code xsd.exe generated. The tests take it with
     their coverage-settings option, and eng/coverage-gate.cs holds what they measure to the floors in
     eng/coverage.json (AGENTS.md, Build and test). The extension leaves the test assembly out by itself under
     Microsoft.Testing.Platform. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Tableau\.Api\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <!-- By file, not by the GeneratedCode attribute that xsd.exe puts on each type: three of those types are partial,
         and their hand-written halves in SchemaExtensions.cs are measured.
         What a source generator writes into obj/ at build time is no code of the repo either: System.Text.Json's
         metadata for the models is over forty thousand lines, which would outweigh the library's own code and bury a
         drop in its coverage. The models the repo's generator writes, Rest/Models/Generated/, are in the repo and are
         measured. -->
    <Sources>
      <Exclude>
        <Source>.*[\\/]Models[\\/]XmlSchema\.cs$</Source>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <!-- Instrument the library before the run rather than through the CLR profiler, which would attach to every .NET
         process the tests start too. -->
    <EnableStaticManagedInstrumentation>True</EnableStaticManagedInstrumentation>
    <EnableDynamicManagedInstrumentation>False</EnableDynamicManagedInstrumentation>
  </CodeCoverage>
</Configuration>
