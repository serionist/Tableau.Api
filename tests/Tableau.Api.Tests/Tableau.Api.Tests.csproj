<Project Sdk="Microsoft.NET.Sdk">

  <!-- The offline tests: the library, as users get it, driven against a fake Tableau server on a loopback port. A test
       application on MSTest and Microsoft.Testing.Platform, which global.json selects for dotnet test. It targets net10.0
       everywhere, and net48 on Windows too: 1.x is the line .NET Framework users stay on, and .NET Framework runs only
       there. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.Analyzers" Version="4.5.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Tableau.Api\Tableau.Api.csproj" />
  </ItemGroup>

</Project>
