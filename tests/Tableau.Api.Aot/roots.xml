<?xml version="1.0" encoding="utf-8"?>
<!-- The 2.0 types the native AOT publish keeps whole, used by the app or not, so the compiler analyses every member of
     each and fails the publish on any trim or AOT warning in them. 2.0 shares the root namespace Tableau.Api with the
     old client, whose XmlSerializer and Newtonsoft.Json code can never pass, so only 2.0's types are listed: a namespace
     only 2.0 has, whole, and otherwise each type by its full name. Each step that adds a public type adds it here, and
     ModelRootsTests fails on a public type of the library that is in neither this list nor its list of the old
     client's types. Once the old client is gone, the whole library is kept and this list goes. -->
<linker>
  <assembly fullname="Tableau.Api">
    <!-- The models generated from Tableau's schema, with their converters and the JSON context. -->
    <namespace fullname="Tableau.Api.Rest.Models" />
    <!-- The client: its options, its registration with DI, its exception, its downloads and its sub-clients. -->
    <type fullname="Tableau.Api.ServerClient" />
    <type fullname="Tableau.Api.TableauClient" />
    <type fullname="Tableau.Api.TableauClientBuilder" />
    <type fullname="Tableau.Api.TableauClientOptions" />
    <type fullname="Tableau.Api.TableauDeployment" />
    <type fullname="Tableau.Api.TableauDownload" />
    <type fullname="Tableau.Api.TableauErrorKind" />
    <type fullname="Tableau.Api.TableauException" />
    <type fullname="Tableau.Api.TableauFileKind" />
    <type fullname="Tableau.Api.TableauServiceCollectionExtensions" />
  </assembly>
</linker>
